+import os
 import random
 
 
+def build_id():
+    configured = os.environ.get("QMK_BUILD_ID")
+    if configured is None:
+        return random.randrange(0, 2 ** 24 - 1)
+    value = int(configured, 0)
+    if not 0 <= value < 2 ** 24:
+        raise ValueError("QMK_BUILD_ID must fit in 24 bits")
+    return value
+
